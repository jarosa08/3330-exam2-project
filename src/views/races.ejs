<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RaceHub</title>
    <!-- images from magnific -->
    <!-- css done with assitance of ai -->
    <link rel="stylesheet" href="css/styles.css">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://code.jquery.com/ui/1.14.2/jquery-ui.js"></script>
</head>

<body>

    <!-- header section -->
    <%- include("partials/header.ejs")%>

    <nav class="header-links">
        <!-- links section -->
        <%- include("partials/links.ejs")%>

    </nav>

    <main>
        <h2>Races</h2>
        <% if(locals.user && user.accountType == "ORGANIZER"){%>
            <!-- <button type="button" class="race-buttons" id="create-race-button"><b>+ RACE</b></button> -->
            <div>
                <h3>New Race</h3>
                <hr>
                <br>
                <section>
                    <form id="updateRaceForm" action="/races" method="POST">
                        <div> <!--class="update-race">-->
                            <label for="updateNameInput">Race Name: </label>
                            <br>
                            <input type="text" id="updateNameInput" name="updateNameInput" required>
                        <!-- </div> -->

                        <!-- <div class="update-race"> -->
                            <label for="updateURLInput">Race url: </label>
                            <br>
                            <input type="text" id="updateURLInput" name="updateURLInput" required>
                        <!-- </div> -->
                            
                        <!-- <div class="update-race"> -->
                            <label for="updateDateInput">Date of Event: </label>
                            <br>
                            <input type="date" id="updateDateInput" name="updateDateInput" required>
                        <!-- </div> -->

                        <!-- <div class="update-race"> -->
                            <label for="updateLocationInput">Location: </label>
                            <br>
                            <input type="text" id="updateLocationInput" name="updateLocationInput" required>
                        <!-- </div> -->

                        <!-- <div class="update-race"> -->
                            <label for="updateInfoInput">Info: </label>
                            <br>
                            <textarea type="text" id="updateInfoInput" name="updateInfoInput" required></textarea>
                        <!-- </div> -->

                        <!-- <div class="update-race"> -->
                            <label for="updateMaxRunnersInput">Max Participants: </label>
                            <br>
                            <input type="number" id="updateMaxRunnersInput" name="updateMaxRunnersInput" value="50" required>
                        <!-- </div> -->

                        <!-- <div class="update-race"> -->
                            <label for="updateTimedByInput">Timed By: </label>
                            <br>
                            <input type="text" id="updateTimedByInput" name="updateTimedByInput" required>
                        </div>

                        <div class="update">
                            <button id="update-button" type="submit" >CREATE</button>
                        </div>
                    </form>
                </section>

            </div>
        <% } %>
        <% const today = new Date().toISOString().split('T')[0]; %>


        <!-- <div class="races-registered runner-only">
            <h3>Registered Races</h3>
            <hr>
            <br>
            <div>
                <% if(locals.races) {%>
                    <% races.forEach((race) => { %>
                            <section>
                                <div>
                                    <h4><%= race.name %></h4>
                                    <ul>
                                        <li><%= race.date %></li>
                                        <li><%= race.location %></li>
                                        <li><%= race.info %></li>
                                        <br>
                                        <li>Registered: <%= race.currentRunners %>/<%= race.maxRunners %></li>
                                        <li>Timed By: <%= race.timedBy %></li>
                                        <li>Posted By: <%= race.postedBy %></li>
                                    </ul>
                                </div>
                            </section>
                    <% }); %>
                <% } %>
            </div>
        </div> -->

        <div class="races-past">
            <h3>Past Races</h3>
            <hr>
            <br>
            <div>
                <% if(locals.races) {%>
                    <% races.forEach((race) => { %>
                        <% if (race.date < today) {%>
                            <section>
                                <div>
                                    <h4><%= race.name %></h4>
                                    <ul>
                                        <li><%= race.date %></li>
                                        <li><%= race.location %></li>
                                        <li><%= race.info %></li>
                                        <br>
                                        <li>Registered: <%= race.currentRunners %>/<%= race.maxRunners %></li>
                                        <li>Timed By: <%= race.timedBy %></li>
                                        <li>Posted By: <%= race.postedBy %></li>
                                    </ul>
                                    <div class="buttons">
                                        <% if(locals.user && user.accountType == "RUNNER"){%>
                                            <a href="/race/<%= race.event_url %>" class="race-buttons runner-only">RESULTS</a>
                                        <% } %>
                                    </div>
                                </div>
                            </section>
                        <% } %>
                    <% }); %>
                <% } %>
            </div>
        </div>

        <div class="races-present">
            <h3>Current Races</h3>
            <hr>
            <br>
            <div>
                <% if(locals.races) {%>
                    <% races.forEach((race) => { %>
                        <% if (race.date == today) {%>
                            <section>
                                <div>
                                    <h4><%= race.name %></h4>
                                    <ul>
                                        <li><%= race.date %></li>
                                        <li><%= race.location %></li>
                                        <li><%= race.info %></li>
                                        <br>
                                        <li>Registered: <%= race.currentRunners %>/<%= race.maxRunners %></li>
                                        <li>Timed By: <%= race.timedBy %></li>
                                        <li>Posted By: <%= race.postedBy %></li>
                                    </ul>
                                    <div class="buttons">
                                        <% if(locals.user && user.accountType == "ORGANIZER") {%>
                                            <a href="/race/edit/<%=race.event_url%>" class="race-buttons organizer-only">EDIT</a>
                                        <% } %>
                                        <% if(locals.user && user.accountType == "RUNNER"){%>
                                            <a href="/race/<%= race.event_url %>" class="race-buttons runner-only">RESULTS</a>
                                        <% } %>                                        <!-- <button type="button" class="race-buttons runner-only">Register</button> -->
                                    </div>
                                </div>
                            </section>
                        <% } %>
                    <% }); %>
                <% } %>
            </div>
        </div>

        <div class="races-future">
            <h3>Upcoming Races</h3>
            <hr>
            <br>
            <div>
                <% if(locals.races) {%>
                    <% races.forEach((race) => { %>
                        <% if (race.date > today) {%>
                            <section>
                                <div>
                                    <h4><%= race.name %></h4>
                                    <ul>
                                        <li><%= race.date %></li>
                                        <li><%= race.location %></li>
                                        <li><%= race.info %></li>
                                        <br>
                                        <li>Registered: <%= race.currentRunners %>/<%= race.maxRunners %></li>
                                        <li>Timed By: <%= race.timedBy %></li>
                                        <li>Posted By: <%= race.postedBy %></li>
                                    </ul>
                                    <div class="buttons">
                                        <% if(locals.user && user.accountType == "ORGANIZER") {%>
                                            <a href="/race/edit/<%=race.event_url%>" class="race-buttons organizer-only">EDIT</a>
                                        <% } %>
                                        <% if(locals.user && user.accountType == "RUNNER"){%>
                                            <% const isRegistered = race.registeredUsers && race.registeredUsers.includes(user.email.toLowerCase()); %>
                                            <% if (isRegistered) { %>
                                                <button type="button" class="race-buttons runner-only REGISTERED" style="background-color: #707070;" disabled>REGISTERED</button>
                                            <% } else { %>
                                                <button type="button" class="race-buttons runner-only race-register-button" data-url="<%= race.event_url %>" onclick="register(this)">REGISTER</button>
                                            <% } %>
                                        <% } %>  
                                    </div>
                                </div>
                            </section>
                        <% } %>
                    <% }); %>
                <% } %>
            </div>
        </div>

    </main>
        
    <!-- footer section -->
    <%- include("partials/footer.ejs")%>

    <!-- include js -->
    <script src="/js/calculator.js"></script>
    <script src="/js/login.js"></script>

</body>
</html>