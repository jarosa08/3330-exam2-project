<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RaceHub</title>
    <!-- images from magnific -->
    <!-- css done with assitance of ai -->
    <link rel="stylesheet" href="/css/styles.css">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://code.jquery.com/ui/1.14.2/jquery-ui.js"></script>
</head>

<body>

    <!-- header section -->
    <%- include("partials/header.ejs")%>

    <nav class="header-links">
        <!-- links section -->
        <%- include("partials/links.ejs")%>

    </nav>

    <main>
        <h2>The Place Made With Runners And Organizers In Mind</h2>
        <section class="about-section">
            <div>
                <img src="images/different-people-participating-cross-country.jpg" alt="different-people-participating-cross-country">
            </div>
            <div>
                <h3><a href="/" class="main-link">RACEHUB</a></h3>
                <p>RACEHUB was created for runners with simplicity in mind. One platform that does it all.</p>
                <ul>
                    <li>One platform for both runners and organizers.</li>
                    <li>All races listed in one place.</li>
                    <li>Easy race registration for runners.</li>
                    <li>Easy race creation for race organizers.</li>
                    <li>Easy race result viewing and browsing.</li>
                </ul>
            </div>
        </section>

        <section class="races-section">
            <div>
                <img src="images/couple-jogging-running-outdoors-park-near-water-young-bearded-man-woman-exercising-together-morning.jpg" alt="couple-jogging-running-outdoors-park-near-water-young-bearded-man-woman-exercising-together-morning">
            </div>
            <div>
                <h3><a href="/races" class="main-link">RACES</a></h3>
                <p>Discover, register, and create runs for everyone to enjoy!</p>
            </div>
        </section>

        <section class="calculator-section">
            <div>
                <img src="images/top-view-close-up-fit-african-sportsman.jpg" alt="top-view-close-up-fit-african-sportsman">
            </div>
            <div>
                <h3><a href="/calculator" class="main-link">PACE CALCULATOR</a></h3>
                <p>Need help training? Use the pace calculator to help with your pacing.</p>
            </div>
        </section>

        <section class="account-section">
            <div>
                <h3><a href="login" class="main-link">ACCOUNT</a></h3>
                <p>Create an account to make signing up for runs much easier.</p>
            </div>
        </section>
    </main>    

    <!-- footer section -->
    <%- include("partials/footer.ejs")%>

    <!-- include js -->
    <script src="/js/calculator.js"></script>
    <script src="/js/login.js"></script>

</body>
</html>