<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RaceHub</title>
    <!-- images from magnific -->
    <!-- css done with assitance of ai -->
    <link rel="stylesheet" href="css/styles.css">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://code.jquery.com/ui/1.14.2/jquery-ui.js"></script>
</head>

<body>

    <!-- header section -->
    <%- include("partials/header.ejs")%>

    <nav class="header-links">
        <!-- links section -->
        <%- include("partials/links.ejs")%>

    </nav>

    <main>
        <h2>Log In - Register Page</h2>

        <div class="account-form">

            <form action="/login" method="POST">
                <div class="account-buttons">
                    <button type="button" class="log-in-button">LOG IN</button>
                    <button type="button" class="register-button">REGISTER</button>
                </div>

                <div class="first-name register">
                    <label for="form-first-name">First Name:</label>
                    <input type="text" id="first-name-input" name="first-name-input" >
                </div>
            
                <div class="last-name register">
                    <label for="form-last-name">Last Name:</label>
                    <input type="text" id="last-name-input" name="last-name-input" >    
                </div>
            
                <div class="DOB register">
                    <label for="form-DOB">Date of Birth:</label>
                    <input type="date" id="DOB-input" name="DOB-input" >
                </div>

                <div class="gender">
                    <label for="form-gender" class="register">Gender</label>

                    <label for="form-male" class="register">Male</label>
                    <input type="radio" id="male-input" name="gender-input" class="register" value="male" checked>

                    <label for="form-female" class="register">Female</label>
                    <input type="radio" id="female-input" name="gender-input" class="register" value="female">
                </div>

                <div class="email log-in">
                    <label for="form-email">Email:</label>
                    <input type="email" id="email-input" name="emailinput" required>
                </div>

                <div class="password log-in">
                    <label for="form-password">Password:</label>
                    <input type="password" id="password-input" name="passwordinput" required>
                </div>

                <div class="account-types">
                    <label for="form-account-type" class="register">Account Type</label>
                    <label for="form-runner" class="register">Runner</label>

                    <input type="radio" id="runner-input" name="type-input" class="register" value="RUNNER" checked>

                    <label for="form-organizer" class="register">Organizer</label>
                    <input type="radio" id="organizer" name="type-input" class="register" value="ORGANIZER">
                </div>

                <div class="continue">
                    <button id="continue-button" type="submit">CONTINUE</button>
                </div>
            </form>
        </div>
    </main>

    <!-- footer section -->
    <%- include("partials/footer.ejs")%>

    <!-- include js -->
    <script src="js/calculator.js"></script>
    <script src="js/login.js"></script>

</body>
</html>